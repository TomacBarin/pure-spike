NODE_ENV=development
PORT=3001

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pure-spike?retryWrites=true&w=majority

# JWT secrets (generate long random strings)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin (for CORS)
FRONTEND_ORIGIN=http://localhost:5173